# Copy to .env.local and fill in. Never commit real values.

# --- Database (PostgreSQL) -----------------------------------------------
# Runtime connection used by the app.
#   Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
#   e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Direct (non-pooled) connection used by Prisma migrations.
#   Supabase: "Session pooler" or direct connection (port 5432)
DIRECT_URL=""

# --- Security --------------------------------------------------------------
# Random secret used to hash visitor IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""

# --- Authentication (Better Auth) ----------------------------------------
# Random secret (32+ chars) used to sign session cookies. Unique per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Public origin of the site, e.g. https://aida.example.org (http://localhost:3000 locally)
BETTER_AUTH_URL=""

# Local development only: shadow database used by `prisma migrate dev`.
# SHADOW_DATABASE_URL=""
